generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  password           String
  role               UserRole
  studentId          String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  classes            ClassEnrollment[]
  createdClasses     Class[]            @relation("ClassCreator")
  feedbackGiven      Feedback[]         @relation("FeedbackGiver")
  feedbackReceived   Feedback[]         @relation("FeedbackReceiver")
  groupMemberships   GroupMember[]
  pointsTransactions PointTransaction[]
  redemptions        Redemption[]

  @@map("users")
}

model Class {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique
  description      String?
  semester         String
  professorId      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  enrollments      ClassEnrollment[]
  professor        User              @relation("ClassCreator", fields: [professorId], references: [id])
  groups           Group[]
  feedbackTemplate FeedbackTemplate?
  feedbacks        Feedback[]

  @@map("classes")
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  userId    String
  classId   String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, classId])
  @@map("class_enrollments")
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  classId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  class       Class         @relation(fields: [classId], references: [id])

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, groupId])
  @@map("group_members")
}

model Feedback {
  id         String       @id @default(cuid())
  content    String
  type       FeedbackType
  points     Int
  category   String
  giverId    String
  receiverId String
  classId    String?
  groupId    String?
  isPublic   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  giver      User         @relation("FeedbackGiver", fields: [giverId], references: [id])
  receiver   User         @relation("FeedbackReceiver", fields: [receiverId], references: [id])
  class      Class?       @relation(fields: [classId], references: [id])

  @@map("feedback")
}

model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  description String
  feedbackId  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@map("point_transactions")
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  description String
  pointsCost  Int
  partner     String
  isActive    Boolean      @default(true)
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id        String           @id @default(cuid())
  userId    String
  rewardId  String
  status    RedemptionStatus @default(PENDING)
  code      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  reward    Reward           @relation(fields: [rewardId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@map("redemptions")
}

enum UserRole {
  ADMIN
  PROFESSOR
  STUDENT
}

enum FeedbackType {
  POSITIVE
  IMPROVEMENT
}

model FeedbackTemplate {
  id          String                     @id @default(cuid())
  name        String
  description String?
  classId     String                     @unique
  class       Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  categories  FeedbackTemplateCategory[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@map("feedback_templates")
}

model FeedbackTemplateCategory {
  id                String           @id @default(cuid())
  name              String
  description       String?
  pointsPositive    Int              @default(5)
  pointsImprovement Int              @default(-2)
  order             Int              @default(0)
  templateId        String
  template          FeedbackTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("feedback_template_categories")
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}
